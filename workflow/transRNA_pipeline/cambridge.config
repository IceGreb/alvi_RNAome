/*
================================================================================
  cambridge.config  —  Cambridge HPC (CSD3) profile
  Adapted from the user's nf-core Cambridge profile.
================================================================================
*/

params {
    config_profile_description = 'Cambridge HPC cluster profile (CSD3).'
    config_profile_url         = "https://docs.hpc.cam.ac.uk/hpc"

    // Set on the command line via run.sh:  --partition icelake  --project MAORI-SL2-CPU
    partition  = null
    project    = null

    max_memory = 192.GB
    max_cpus   = 56
    max_time   = 12.h

    tmpdir = "<path/to/tmp/directory>"

    // Where Nextflow builds/caches the per-process conda envs declared in
    // config/envs/*.yaml (see the conda block below). Point this outside
    // your home quota — envs are rebuilt here only once, then reused.
    conda_cache_dir = "<path/to/conda/env/cache>"
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B ${params.tmpdir}:/tmp"
}

// Every process now declares its own conda env (config/envs/*.yaml) instead
// of relying on one pre-built shared env — see main.nf's `conda "..."` lines.
// useMamba speeds up env solving; requires mamba to be available wherever
// conda itself is (see beforeScript below).
conda {
    enabled  = true
    useMamba = true
    cacheDir = params.conda_cache_dir
}

process {
    resourceLimits = [
        memory: 192.GB,
        cpus:   56,
        time:   12.h
    ]
    executor       = 'slurm'
    clusterOptions = "-A ${params.project} -p ${params.partition}"

    // ── Resource labels ───────────────────────────────────────────────────────
    withLabel: 'count_only' {
        cpus   = 2
        memory = 8.GB
        time   = 1.h
    }
    withLabel: 'low' {
        cpus   = 4
        memory = 16.GB
        time   = 2.h
    }
    withLabel: 'med' {
        cpus   = 8
        memory = 32.GB
        time   = 6.h
    }
    withLabel: 'high' {
        cpus   = 16
        memory = 64.GB
        time   = 12.h
    }

    // ── Per-process overrides ─────────────────────────────────────────────────
    withName: 'TRIMGALORE' {
        // trim_galore --cores N actually spawns ~4x N threads (read + write +
        // cutadapt + extra cutadapt + trim_galore itself) — request enough
        // SLURM cpus to cover that even though --cores itself stays at
        // params.trim_cores.
        cpus   = { (params.trim_cores ?: 4) * 4 }
        memory = 32.GB
        time   = 6.h
    }
    withName: 'COLLAPSE_READS' {
        // seqkit rmdup on large .fq can need significant memory
        cpus   = 8
        memory = 48.GB
        time   = 4.h
    }
    withName: 'ANNOTATE_KRAKEN' {
        cpus   = 4
        memory = 24.GB
        time   = 4.h
    }
    withName: 'ANNOTATE_BLAST' {
        // BLAST TSVs can be ~500 MB each; taxonkit subprocess is memory-hungry
        cpus   = 4
        memory = 64.GB
        time   = 6.h
    }
    withName: 'TAXONOMY_PARSER' {
        // Runs once globally across all samples
        cpus   = 4
        memory = 32.GB
        time   = 4.h
    }

    // ── Retry on transient HPC / RDS I/O errors ───────────────────────────────
    errorStrategy = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    // ── Make conda/mamba itself available on the compute node ────────────────
    beforeScript = 'eval "$(conda shell.bash hook)"'
}

