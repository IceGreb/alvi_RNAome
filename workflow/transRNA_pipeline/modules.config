/*
================================================================================
  modules.config  —  per-process configuration for vendored nf-core modules
  (modules/nf-core/*). Keeps the vendored module files themselves unmodified
  so they stay easy to re-sync from upstream (nf-core modules update).

  Resource sizing (cpus/memory/time) for these modules' process_* labels is
  set in cambridge.config / nextflow.config's local profile, not here — this
  file is only for module-specific options: publishDir, ext.args, ext.prefix.
================================================================================
*/

process {
    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/reports/00_fastqc_raw" },
            mode: 'copy'
        ]
    }
}
