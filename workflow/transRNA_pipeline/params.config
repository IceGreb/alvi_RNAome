// =============================================================================
//  transRNA pipeline v1.2 — default parameters
//  Edit this file for pipeline-wide defaults. Run from the pipeline directory
//  with:
//    bash run.sh                                          # fresh run
//    bash run.sh --resume                                 # resume after failure
//    bash run.sh --params-file config/params/X.yml         # project-specific
//                                                           # overrides layered
//                                                           # on top of these
//                                                           # defaults (via
//                                                           # Nextflow's
//                                                           # -params-file,
//                                                           # which always
//                                                           # wins over this
//                                                           # config file)
//
//  All paths marked <...> must be set to absolute paths on your system
//  before running.
//
//  This file is loaded automatically (includeConfig'd from nextflow.config)
//  rather than passed as -params-file, specifically so that a project's own
//  -params-file (e.g. config/params/alvi_rnaome.yml) can override individual
//  values here. Nextflow only allows one -params-file per run and it always
//  takes priority over any -c/includeConfig'd params {} block — so pipeline
//  defaults have to live here, not in a second -params-file, for real
//  layering to work.
// =============================================================================

params {

    // ── Sample sheet ──────────────────────────────────────────────────────────
    sample_sheet = "samples.csv"

    // ── Output root ───────────────────────────────────────────────────────────
    outdir = "<path/to/output/directory>"

    // ── Reference / annotation files ─────────────────────────────────────────
    invertebrate_phyla = "<path/to/invertebrate_phyla.txt>"

    // taxonkit NCBI taxonomy database directory (nodes.dmp, names.dmp etc.)
    taxonkit_db = "<path/to/.taxonkit>"

    // Pre-built STAR genome index directory (STAR --runMode genomeGenerate output).
    star_genome_dir = "<path/to/STAR/genome/index>"

    // ── Input data directories ───────────────────────────────────────────────
    // Raw reads are no longer set here — each sample's fastq_1/fastq_2 paths
    // are read directly from the sample sheet (see samples.csv). Any number
    // of groups with any labels are supported.

    // Trimmed reads are produced by TRIMGALORE by default — trimmed_dir is
    // only used when skip_trimming: true (see below), pointing at
    // pre-trimmed reads already matching
    // {trimmed_dir}/{sample}_{1,2}_trimmed.fq.gz.
    trimmed_dir = "<path/to/trimmed_reads>"

    // STAR unmapped reads are produced by STAR by default — star_dir is only
    // used when skip_star: true (see below), pointing at pre-computed
    // unmapped reads already matching
    // {star_dir}/{sample}/{sample}_Unmapped.out.mate1.
    star_dir = "<path/to/STAR/unmapped/output>"

    // BBsplit unmatched reads (pipeline step 4) are produced by BBSPLIT by
    // default — bbsplit_dir is only used when skip_bbsplit: true, pointing
    // at pre-computed unmatched reads already matching
    // {bbsplit_dir}/{sample}/{sample}_bbsplit_unmatched_1.fq.
    bbsplit_dir = "<path/to/BBSplit/unmatched/output>"

    // BBsplit MAG-clean: {bbsplit_mags_dir}/no_MAGs_{sample}_2MM_clean1.fq
    bbsplit_mags_dir = "<path/to/bbsplit/noMAGs/filtered>"

    // Kraken output:     {kraken_dir}/{sample}_2MM_CLEAN_noMAGs_kraken_output_005_.txt
    kraken_dir = "<path/to/kraken/output>"

    // BLAST output:      {blast_dir}/{sample}_1.tsv  and  {sample}_2.tsv
    blast_dir = "<path/to/blast/output>"

    // ── TrimGalore ────────────────────────────────────────────────────────────
    // Values below are TrimGalore's own defaults, spelled out explicitly so
    // they're visible/adjustable here rather than hidden behind the tool.
    // Anything else (e.g. explicit adapters) goes in trim_extra_args.
    trim_quality    = 20    // Phred quality cutoff
    trim_stringency = 1     // min adapter-overlap (bp) required to trim
    trim_length     = 20    // discard reads shorter than this after trimming
    trim_cores      = 4     // passed to `trim_galore --cores`; TrimGalore's
                             // own docs call 4 the practical sweet spot —
                             // actual thread usage runs well above this (see
                             // cambridge.config's TRIMGALORE override)
    trim_extra_args = ""    // e.g. "-a AGATCGGAAGAGC -a2 GATCGTCGGACT --trim-n"

    // ── STAR ──────────────────────────────────────────────────────────────────
    // Only structural flags (genomeDir, readFilesCommand, outSAMtype,
    // outReadsUnmapped) are hard-coded in main.nf — alignment sensitivity is
    // left at STAR's own defaults. Anything else (e.g. project-specific
    // filtering) goes in star_extra_args — see config/params/alvi_rnaome.yml
    // for an example.
    star_extra_args = ""

    // ── BBSplit ──────────────────────────────────────────────────────────────
    // Pipeline step 4 — decontaminates STAR's unmapped reads against host +
    // human + viral references, catching contamination STAR's own bee-genome
    // mapping alone can't (STAR only ever sees the bee genome). Only
    // structural flags (in1/in2, ref, basename, outu1/outu2, refstats) are
    // hard-coded in main.nf — alignment sensitivity is left at BBSplit's own
    // defaults. Anything else (e.g. project-specific tuning) goes in
    // bbsplit_extra_args — see config/params/alvi_rnaome.yml for an example.
    bbsplit_extra_args   = ""
    bbsplit_keep_matched = false   // publish the per-reference-genome matched
                                     // reads too — not required by the tool or
                                     // downstream, only the unmatched/clean reads are

    // ── Collapse (dedup) ordering ─────────────────────────────────────────────
    // "pre_taxonomy"  (default) — dedup right after BBSplit, before Kraken/
    //                  BLAST ever see a read. Standard for any dataset run
    //                  through this pipeline from here on.
    // "post_taxonomy" — dedup after Kraken/BLAST annotation + filtering, by
    //                  extracting the reads that already passed. Needed only
    //                  for a dataset whose Kraken/BLAST already ran on the
    //                  full, non-deduplicated pool before this pipeline
    //                  existed — see config/params/alvi_rnaome.yml.
    collapse_mode = "pre_taxonomy"

    // ── Filtering thresholds ──────────────────────────────────────────────────
    min_occ = 5      // minimum duplicate count for a read to be a candidate (≥5)
    min_len = 18      // minimum alignment/read length in nt (≥18)

    // ── Taxonomy priority ─────────────────────────────────────────────────────
    // When a read ID appears in BOTH filtered Kraken and filtered BLAST:
    // which tool's taxonomy is used? "blast" = BLAST first (recommended)
    priority = "blast"

    // ── Taxonomy plot parameters ─────────────────────────────────────────────
    tax_plot_threshold   = 0.1    // taxa < this % → folded into Other
    tax_plot_max_normals = 10     // max taxa shown per panel (excl. Other/Unclassified)
    tax_plot_xbreak      = 2.5    // x-axis break point (%)

    // ── Skip flags ────────────────────────────────────────────────────────────
    // All false by default. Use `bash run.sh --resume` for simple reruns.
    // These flags skip entire sections; useful when you want to regenerate
    // only a specific output without re-running the full pipeline.
    //
    //   skip_count_reports  skip all COUNT_* processes and MAKE_READS_POSTTRIM_TAB.
    //                       Also disables AGGREGATE_REPORT (no stats to aggregate).
    //                       If taxonomy is still needed, reads_posttrim_tab.tsv is
    //                       loaded from outdir/reports/ automatically.
    //
    //   skip_collapse       skip whichever COLLAPSE_READS_* process
    //                       collapse_mode selects, and load its outputs from
    //                       outdir/collapsed/. Annotation + filtering still runs
    //                       because those outputs feed the taxonomy parser.
    //
    //   skip_extract_fasta  skip EXTRACT_FASTA only (FASTA file not produced).
    //
    //   skip_taxonomy       skip TAXONOMY_PARSER and PLOT_TAXONOMY.
    //
    //   skip_length_plot    skip PLOT_LENGTH_DIST only.
    //
    //   skip_report         skip AGGREGATE_REPORT only.
    //
    //   skip_fastqc         skip FASTQC/MULTIQC (raw + trimmed-read QC). Runs via
    //                       Singularity (cambridge.config), not the shared conda env.
    //
    //   skip_trimming       skip TRIMGALORE and load pre-trimmed reads from
    //                       trimmed_dir instead (see above).
    //
    //   skip_star           skip STAR and load pre-computed unmapped reads from
    //                       star_dir instead (see above).
    //
    //   skip_bbsplit        skip BBSPLIT and load pre-computed unmatched reads
    //                       from bbsplit_dir instead (see above).
    //
    skip_count_reports = false
    skip_collapse      = false
    skip_extract_fasta = false
    skip_taxonomy      = false
    skip_length_plot   = false
    skip_report        = false
    skip_fastqc        = false
    skip_trimming      = false
    skip_star          = false
    skip_bbsplit       = false
}
